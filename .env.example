# LOCAS CASHBACK · Railway shows every variable below in the Variables tab
# (Suggested Variables). Replace each PASTE_… with the real value; a value
# still saying PASTE_… counts as missing and the bot refuses to start, naming it.
# The ones marked "website" are the same values as the website's .env.local.

# ─────────────── Discord ───────────────
# website: DISCORD_BOT_TOKEN (same Discord app; this bot logs in with it and posts)
DISCORD_BOT_TOKEN=PASTE_FROM_WEBSITE
# 1503661074937806880 = LOCAS (production) · 1543227658370809906 = test server
GUILD_ID=1503661074937806880

# ─────────────── Supabase ───────────────
# website: SUPABASE_URL
SUPABASE_URL=PASTE_FROM_WEBSITE
# website: SUPABASE_ANON_KEY (the anon key, never the service-role key)
SUPABASE_ANON_KEY=PASTE_FROM_WEBSITE
# prod = LOCAS · test = test server. Must match GUILD_ID or the bot refuses to start.
SUPABASE_NS=prod
# website: WEB_PASSPORT_RPC_SECRET (64 hex characters)
WEB_PASSPORT_RPC_SECRET=PASTE_FROM_WEBSITE

# ─────────────── People ───────────────
# website: ADMIN_IDS (Discord ids, comma separated; pinged on every "Cashback eligible")
ADMIN_IDS=PASTE_FROM_WEBSITE

# ─────────────── Website ───────────────
# The website's address, e.g. https://locas.up.railway.app (the Claim cashback button opens <it>/protection)
WEBSITE_URL=PASTE_WEBSITE_ADDRESS
# website: CRON_SECRET. Production only: runs the floor check every 30 minutes.
# On the test server leave PASTE_FROM_WEBSITE as it is or empty it: it is ignored there.
CRON_SECRET=PASTE_FROM_WEBSITE

# ─────────────── Optional ───────────────
# How fast a receipt follows Mark paid, in seconds
POLL_SECONDS=15
# How often the floor check runs, in minutes
FLOOR_CHECK_MINUTES=30
