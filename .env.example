# ─────────────── Discord ───────────────
# The website's bot token: same Discord app as the website (DISCORD_BOT_TOKEN
# there). The website only looks members up with it; this bot logs in with it
# and posts.
DISCORD_BOT_TOKEN=
# 1503661074937806880 for LOCAS, 1543227658370809906 for the test server.
GUILD_ID=1503661074937806880

# ─────────────── Shared store (Supabase) ───────────────
# The website's values. The anon key only: every read and write is a signed
# RPC (website migration 0014). Never put the service-role key here.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# prod or test. No default on purpose: a missing value refuses to start, and
# the database refuses a namespace that does not belong to GUILD_ID.
SUPABASE_NS=prod
# The website's WEB_PASSPORT_RPC_SECRET, same value (64 hex characters).
WEB_PASSPORT_RPC_SECRET=

# ─────────────── People ───────────────
# Pinged on every "Cashback eligible" card. The website's ADMIN_IDS.
ADMIN_IDS=

# ─────────────── Website ───────────────
# The "Claim cashback" button opens <WEBSITE_URL>/protection. https in production.
WEBSITE_URL=
# Runs the website's 24h floor check every 30 minutes. The website's
# CRON_SECRET, same value. Required in production; ignored on the test
# namespace (the website's floor check is production-only).
CRON_SECRET=

# ─────────────── Optional ───────────────
# How often new notices are picked up (a receipt reaches the ticket within this long).
POLL_SECONDS=15
FLOOR_CHECK_MINUTES=30
# PORT is set by Railway; the health check listens on /health.
